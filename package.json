{
  "name": "claudex",
  "private": true,
  "version": "1.0.0",
  "description": "Self-hosted web UI for Claude Code: chat, terminals, files, git and previews for all your projects, from any device.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xihuny/claudex.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "start": "pnpm run build && node server/index.js",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');for(const a of ['darwin-arm64','darwin-x64'])try{fs.chmodSync(p.join('node_modules','node-pty','prebuilds',a,'spawn-helper'),0o755)}catch(e){}\""
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@formkit/auto-animate": "^0.8.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "express": "^4.22.3",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "node-pty": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.6"
  }
}
